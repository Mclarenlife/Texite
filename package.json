{
  "name": "texite",
  "version": "0.12.0-beta.4",
  "private": true,
  "description": "A local-first LaTeX writing studio for the web, Windows and macOS.",
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "dev:android": "vite --mode android --host 127.0.0.1 --port 5182",
    "build:android": "tsc --noEmit && vite build --mode android && cap sync android",
    "android:runtime": "python scripts/prepare-android-runtime.py",
    "dist:android": "pnpm build:android && node scripts/package-android.mjs",
    "dev:ios": "vite --mode ios --host 127.0.0.1 --port 5185",
    "build:ios": "tsc --noEmit && vite build --mode ios && cap sync ios",
    "dist:ios": "pnpm build:ios && node scripts/package-ios.mjs",
    "package": "pnpm runtime:verify && pnpm build && install-electron && electron-builder --dir --publish never",
    "dist:win": "pnpm runtime:verify && pnpm build && install-electron && electron-builder --win nsis --publish never",
    "dist:mac": "pnpm runtime:verify && pnpm build && install-electron && electron-builder --mac dmg --publish never",
    "runtime:prepare": "python scripts/build-modular-runtime.py",
    "runtime:verify": "node scripts/verify-runtime.cjs"
  },
  "build": {
    "appId": "com.texite.app",
    "productName": "Texite",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/**/*",
      "LICENSE",
      "NOTICE",
      "docs/runtime-notices.txt",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "default.texite-runtime.zip",
          "helpers.texite-runtime.zip",
          "modular-manifest.json",
          "licenses/**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "8.5.3",
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.64.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@types/katex": "^0.16.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "codemirror": "6.0.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "idb": "8.0.4",
    "katex": "^0.19.0",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@wasm-zoo/ghostscript": "0.7.2",
    "jszip": "3.10.2"
  },
  "author": "Mclarenlife",
  "license": "GPL-3.0-only"
}
